# ==============================================================================
# Nishdot Web Platform — .gitignore
# ==============================================================================

# ----------------------------- Python -----------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl

# ----------------------------- Virtual Environment ----------------------------
venv/
.venv/
env/

# ----------------------------- Django -----------------------------------------
*.log
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# ----------------------------- Environment Variables --------------------------
.env
.env.local
.env.production

# ----------------------------- IDE / Editor -----------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ----------------------------- OS Generated -----------------------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ----------------------------- Node (Tailwind CSS) ----------------------------
node_modules/
# package-lock.json COMMIT edilir — tekrarlanabilir (reproducible) build için.

# ----------------------------- Büyük Orijinal Görseller -----------------------
# Web'de yalnızca .webp sürümleri kullanılır. Yüksek çözünürlüklü orijinaller
# repo'yu şişiriyordu (~200 MB) — takipten çıkarıldı, lokalde kalır.
static/images/hero/*.JPG
static/images/hero/*.jpg
static/images/nishyearafis.png

# ----------------------------- Misc -------------------------------------------
*.bak
*.tmp
*.temp
.cache/
