{
  "name": "nishdot-web",
  "version": "1.0.0",
  "private": true,
  "description": "İstanbul Nişantaşı Üniversitesi Dijital Oyun Tasarımı Kulübü (Nishdot) web platformu — Tailwind CSS derleme araçları.",
  "main": "postcss.config.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css --minify",
    "watch:css": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Omercekadam/nishdot-web.git"
  },
  "keywords": [],
  "author": "Ömer Soysal",
  "license": "UNLICENSED",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Omercekadam/nishdot-web/issues"
  },
  "homepage": "https://github.com/Omercekadam/nishdot-web#readme",
  "devDependencies": {
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19"
  }
}
