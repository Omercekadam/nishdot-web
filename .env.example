# ==============================================================================
# Nishdot Web Platform — Ortam Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# ==============================================================================

DJANGO_SECRET_KEY=buraya-guclu-bir-anahtar-yazin
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=nishdot.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3

# SMTP Ayarları (Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sizin-mailiniz@gmail.com
SMTP_PASSWORD=google-app-password
