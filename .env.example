# ==============================================================================
# Nishdot Web Platform — Ortam Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# ==============================================================================

DJANGO_SECRET_KEY=buraya-guclu-bir-anahtar-yazin

# Kişisel veri (T.C. Kimlik No) şifreleme anahtarı — SECRET_KEY'den bağımsız.
# Üretmek için:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=buraya-fernet-anahtari-yazin

DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=nishdot.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3

# Production'da ek olarak (virgülle ayrılmış):
# DJANGO_CSRF_TRUSTED_ORIGINS=https://nishdot.com.tr,https://www.nishdot.com.tr

# SMTP Ayarları (Hesap 1 - Doğrulama)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sizin-mailiniz@gmail.com
SMTP_PASSWORD=google-app-password

# SMTP Ayarları (Hesap 2 - Game Jam / İletişim)
SMTP2_SERVER=smtp.gmail.com
SMTP2_PORT=587
SMTP2_USERNAME=ikinci-mailiniz@gmail.com
SMTP2_PASSWORD=google-app-password
